# ── LLM Wiki — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ───────────────────────────────────────────────────────────────────

# OpenAI API key — used by the wiki query agent, the RAG pipeline (embeddings +
# generation), and the eval harness.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Optional ───────────────────────────────────────────────────────────────────

# Generation model override — defaults to gpt-4o if not set
# Options: gpt-4o | gpt-4o-mini | gpt-4-turbo | o1 | o3-mini
OPENAI_MODEL=gpt-4o

# Embedding model override — defaults to text-embedding-3-small if not set
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Langfuse (optional) ───────────────────────────────────────────────────────
# Tracing/observability for the RAG pipeline (app.py views + eval harness).
# If both keys below are unset, tracing is a no-op — everything behaves exactly
# as without Langfuse. Get keys at: https://cloud.langfuse.com (Project Settings)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
